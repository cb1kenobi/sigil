{
  "name": "@ttylabs/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for sigil and its toolchain",
  "keywords": [],
  "homepage": "https://github.com/cb1kenobi/sigil",
  "bugs": {
    "url": "https://github.com/cb1kenobi/sigil/issues"
  },
  "license": "MIT",
  "author": "Chris Barber <me@chrisbarber.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/cb1kenobi/sigil.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm type-check && pnpm lint && pnpm fmt:check",
    "coverage": "turbo run build --filter=@ttylabs/sigil --filter=@ttylabs/cli && vitest --coverage",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "ncu": "turbo ncu ncu:root --",
    "ncu:root": "ncu -c 1d",
    "test": "turbo run build --filter=@ttylabs/sigil --filter=@ttylabs/cli && vitest",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "@ttylabs/cli": "workspace:*",
    "@ttylabs/sigil": "workspace:*",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "lefthook": "2.1.14",
    "oxfmt": "0.69.0",
    "oxlint": "1.85.0",
    "rimraf": "6.1.3",
    "tsdown": "0.23.0",
    "turbo": "2.11.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.5.1"
}
