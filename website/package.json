{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "brand": "node scripts/brand-assets.ts",
    "build": "node scripts/generate-search-index.ts && node scripts/generate-symbol-index.ts && next build",
    "check:contrast": "node scripts/check-contrast.ts",
    "dev": "next dev",
    "fonts": "node scripts/fetch-fonts.ts",
    "fonts:check": "node scripts/fetch-fonts.ts --check",
    "ncu": "ncu -c 1d",
    "search:index": "node scripts/generate-search-index.ts",
    "search:symbols": "node scripts/generate-symbol-index.ts",
    "start": "next start",
    "test": "node --test --experimental-test-module-mocks \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@ttylabs/sigil": "workspace:*",
    "next": "16.4.5",
    "posthog-js": "1.446.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "shiki": "4.5.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "oxc-parser": "0.157.0",
    "pagefind": "1.6.0",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2"
  }
}
