# Browser analytics (SIG-269). Both are optional: with either one unset the site
# runs normally with analytics off, which is the expected setup for local work.
# Deliberately empty rather than placeholder values - a copied placeholder host
# passes the "is it set" check and then fails a request on every page load.
#
# A production deploy (VERCEL_ENV=production) refuses to build without both; see
# src/lib/analytics-env.ts.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST=""
