{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "public/**",
        "next.config.ts",
        "postcss.config.mjs",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    }
  }
}
