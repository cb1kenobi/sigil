{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "scripts/**", "tsdown.config.ts", "tsconfig*.json", "package.json"],
      "outputs": ["dist/**", "registry/**"]
    },
    "ncu": {},
    "//#ncu:root": {},
    "type-check": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "test/**",
        "tsconfig*.json",
        "tsdown.config.ts",
        "vitest.config.ts",
        "package.json"
      ],
      "outputs": []
    }
  },
  "ui": "stream"
}
