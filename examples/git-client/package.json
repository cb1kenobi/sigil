{
  "name": "@ttylabs/example-git-client",
  "version": "0.0.0",
  "private": true,
  "description": "A git client in the shape of lazygit, written twice: in JSX, built, and in the ui tag, run as it is",
  "bin": {
    "git-client": "./dist/git-client.mjs"
  },
  "type": "module",
  "scripts": {
    "build": "sigil build",
    "start": "node dist/git-client.mjs",
    "start:ui": "node src/ui.ts",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ttylabs/sigil": "workspace:*"
  },
  "devDependencies": {
    "@ttylabs/cli": "workspace:*",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
