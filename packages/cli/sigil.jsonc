{
	"build": {
		// `oxc-parser` and `rolldown` are JavaScript around a native `.node`
		// binding, and nothing inlines one of those -- so they stay imports and
		// npm installs them. `@ttylabs/sigil` is external because this is a
		// devDependency of an app rather than part of what the app ships.
		"external": ["@ttylabs/sigil", "oxc-parser", "rolldown"],

		// 203 kB of maps against 38 kB of code, published with the package.
		"sourcemap": false,
	},
}
