{
  "name": "@ttylabs/cli",
  "version": "0.0.1",
  "description": "The sigil toolchain: builds and packages CLI apps",
  "keywords": [],
  "homepage": "https://github.com/cb1kenobi/sigil",
  "bugs": {
    "url": "https://github.com/cb1kenobi/sigil/issues"
  },
  "license": "MIT",
  "author": "Chris Barber <me@chrisbarber.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/cb1kenobi/sigil.git",
    "directory": "packages/cli"
  },
  "bin": {
    "sigil": "./dist/sigil.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node src/sigil.ts build",
    "coverage": "vitest --coverage",
    "dev": "node ./src/sigil.ts",
    "ncu": "ncu -c 1d",
    "prepublishOnly": "pnpm run build",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ttylabs/sigil": "workspace:*",
    "oxc-parser": "0.151.0",
    "rolldown": "1.2.11"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "rimraf": "6.1.3",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
