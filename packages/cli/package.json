{
  "name": "@ttylabs/cli",
  "version": "0.0.1",
  "description": "The sigil toolchain: builds and packages CLI apps",
  "keywords": [],
  "homepage": "https://github.com/cb1kenobi/sigil",
  "bugs": {
    "url": "https://github.com/cb1kenobi/sigil/issues"
  },
  "license": "MIT",
  "author": "Chris Barber <me@chrisbarber.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/cb1kenobi/sigil.git",
    "directory": "packages/cli"
  },
  "bin": {
    "sigil": "./dist/sigil.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./utilities": {
      "types": "./dist/utilities.d.mts",
      "default": "./dist/utilities.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsdown -c tsdown.config.ts",
    "coverage": "vitest --coverage",
    "prepublishOnly": "pnpm run build",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ttylabs/sigil": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@vitest/coverage-v8": "5.0.0",
    "rimraf": "6.1.3",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
